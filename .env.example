# ── Kalshi API ───────────────────────────────────────────────
# Get from: https://kalshi.com/profile/api
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_API_SECRET=your_kalshi_api_secret
KALSHI_BASE_URL=https://trading-api.kalshi.com

# ── Discord alerts ────────────────────────────────────────────
DISCORD_WEBHOOK_URL=your_discord_webhook

# ── Signal config ─────────────────────────────────────────────
TIME_WINDOW_MINUTES=15        # how long to wait for 2nd trader
MIN_TRADERS_FOR_SIGNAL=2      # how many top-50 traders must agree
KALSHI_MATCH_THRESHOLD=70     # 0-100 confidence to consider valid
LEADERBOARD_SIZE=50           # top N traders to watch

# ── Paper trade config ────────────────────────────────────────
PAPER_TRADE_SIZE_MIN_USD=3    # min $ per simulated trade
PAPER_TRADE_SIZE_MAX_USD=5    # max $ per simulated trade
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_USD=50
MAX_EXPOSURE_PER_MARKET_USD=20
MAX_EXPOSURE_PER_CATEGORY_USD=50
PRICE_CAP=0.90                # don't buy if price > 90 cents

# ── Kill switch ───────────────────────────────────────────────
# Keep false until paper trading is profitable
ENABLE_REAL_TRADING=false

# ── Polling intervals ─────────────────────────────────────────
POLL_TRADES_MINUTES=5         # how often to fetch trader activity
POLL_LEADERBOARD_HOURS=6      # how often to refresh top 50

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=3000
